   "link": null,
   "locked": false,
   "text": "Bottleneck: tracking, click and unsubscribe links point at API_URL. On localhost no open/click is ever recorded and\nemails look spammy. Fix = public HTTPS URL (tunnel or hosting).",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rec_373",
   "originalText": "Bottleneck: tracking, click and unsubscribe links point at API_URL. On localhost no open/click is ever recorded and emails look spammy. Fix = public HTTPS URL (tunnel or hosting).",
   "autoResize": false,
   "lineHeight": 1.25
  },

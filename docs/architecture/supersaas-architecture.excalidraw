   "link": null,
   "locked": false,
   "text": "Why: AI behind one provider seam (AI_DRIVER mock | bedrock | gemini). Bedrock stays the main path; Gemini lives on\ngoogle-stack to test with real AI until AWS is ready. Mock keeps tests offline.",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rec_379",
   "originalText": "Why: AI behind one provider seam (AI_DRIVER mock | bedrock | gemini). Bedrock stays the main path; Gemini lives on google-stack to test with real AI until AWS is ready. Mock keeps tests offline.",
   "autoResize": false,
   "lineHeight": 1.25
  },

   "link": null,
   "locked": false,
   "text": "Forgot / reset password   [PARTIAL]\n/forgot-password, /reset-password: single-use hashed token, expiry,\nrevokes all sessions. Built + tested, but the email only goes out once\nSYSTEM_SMTP_* works (Gmail app password rejected, 535). Locally the link\nis printed in the API log.",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rec_40",
   "originalText": "Forgot / reset password   [PARTIAL]\n/forgot-password, /reset-password: single-use hashed token, expiry, revokes all sessions. Built + tested, but the email only goes out once SYSTEM_SMTP_* works (Gmail app password rejected, 535). Locally the link is printed in the API log.",
   "autoResize": false,
   "lineHeight": 1.25
  },

   "link": null,
   "locked": false,
   "text": "Scale: schedules live in Redis and Socket.io uses the Redis adapter, so the API can run as several instances behind a\nload balancer (websocket transport only, no sticky sessions needed).",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rec_377",
   "originalText": "Scale: schedules live in Redis and Socket.io uses the Redis adapter, so the API can run as several instances behind a load balancer (websocket transport only, no sticky sessions needed).",
   "autoResize": false,
   "lineHeight": 1.25
  },

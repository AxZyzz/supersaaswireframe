   "link": null,
   "locked": false,
   "text": "Gmail reply sync*  (T5.7)   [PARTIAL]\nEvery 2 min + 'Sync Gmail'. Replies from emailed leads -> inbox\n(quote-stripped, AI-classified, sequence stopped). mailer-daemon\nbounces -> suppression. Personal mail ignored (only its Gmail id\nkept). Built + 4 tests; needs Gmail reconnect with read permission +\nlive test.",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rec_134",
   "originalText": "Gmail reply sync*  (T5.7)   [PARTIAL]\nEvery 2 min + 'Sync Gmail'. Replies from emailed leads -> inbox (quote-stripped, AI-classified, sequence stopped). mailer-daemon bounces -> suppression. Personal mail ignored (only its Gmail id kept). Built + 4 tests; needs Gmail reconnect with read permission + live test.",
   "autoResize": false,
   "lineHeight": 1.25
  },

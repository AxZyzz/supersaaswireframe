   "locked": false,
   "text": "Code gaps found   [PARTIAL]\n- Smart segment with invalid tag id fails silently\n- E2E gaps: add campaign step, add leads to segment, Sheets screens\n- AI emails come back as one paragraph; a {first_name} without fallback seen once\n- Restricted-scope Google verification for gmail.readonly",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rec_363",
   "originalText": "Code gaps found   [PARTIAL]\n- Smart segment with invalid tag id fails silently\n- E2E gaps: add campaign step, add leads to segment, Sheets screens\n- AI emails come back as one paragraph; a {first_name} without fallback seen once\n- Restricted-scope Google verification for gmail.readonly",
   "autoResize": false,
   "lineHeight": 1.25

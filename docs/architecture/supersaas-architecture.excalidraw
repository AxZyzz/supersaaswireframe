   "link": null,
   "locked": false,
   "text": "Trade-off: Postgres RLS isolates tenants even if a query forgets WHERE org_id. Cost: a SET per transaction and\nSECURITY DEFINER functions for the few cross-tenant scans (scheduler, reply sync).",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rec_375",
   "originalText": "Trade-off: Postgres RLS isolates tenants even if a query forgets WHERE org_id. Cost: a SET per transaction and SECURITY DEFINER functions for the few cross-tenant scans (scheduler, reply sync).",
   "autoResize": false,
   "lineHeight": 1.25
  },

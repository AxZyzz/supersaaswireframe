   "updated": 1763510400000,
   "link": null,
   "locked": false,
   "text": "CAP: CP. Single Postgres primary, strong consistency for sends and suppression (never email someone who unsubscribed).\nRedis holds only jobs + counters, so losing it delays work but loses no data.",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rec_381",
   "originalText": "CAP: CP. Single Postgres primary, strong consistency for sends and suppression (never email someone who unsubscribed). Redis holds only jobs + counters, so losing it delays work but loses no data.",
   "autoResize": false,
   "lineHeight": 1.25
  },

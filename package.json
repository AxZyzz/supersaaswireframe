{
  "name": "supersaas",
  "private": true,
  "version": "0.1.0",
  "description": "SuperSaaS — AI outreach platform (working title). Monorepo: apps/api (NestJS), apps/web (Next.js), apps/wireframe (Phase 0 prototype), packages/shared.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:wireframe": "npm run dev -w apps/wireframe",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "engines": {
    "node": ">=22"
  }
}

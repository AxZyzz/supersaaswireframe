# Copy to .env and fill in. NEVER commit real values.

# --- app ---
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
# Production behind a load balancer: number of proxy hops to trust for client IP
# (rate limiting). Leave blank locally.
TRUST_PROXY=
# Beta: "waitlist" makes sign-up invite-only (operator approves waitlist entries
# in /operator and sends the link). Blank/"open" = anyone can sign up.
SIGNUP_MODE=
# Session cookie (httpOnly refresh token). Host web + API on one site
# (app.example.com + api.example.com) and keep "lax". Only if they live on
# unrelated domains use "none" (forces Secure). COOKIE_DOMAIN is usually blank.
COOKIE_SAMESITE=
COOKIE_DOMAIN=
# Scheduled jobs (notification emails every minute, Monday weekly summary,
# Sheets sync). One shared schedule in Redis across instances. "off" = this
# instance doesn't register or run them (it never removes others' schedules).
JOBS_SCHEDULER=
# Swagger UI at /docs is dev-only; set to "on" to expose it in production.
SWAGGER=

# --- database / queue (matches docker-compose.yml) ---
# App connects as restricted role (RLS enforced); superuser URL is ONLY for migrations.
DATABASE_URL=postgresql://supersaas_app:supersaas_app@localhost:5432/supersaas
MIGRATE_DATABASE_URL=postgresql://supersaas:supersaas@localhost:5432/supersaas
REDIS_URL=redis://localhost:6379

# --- auth ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
# Production: random >=32 chars each, different from each other (boot fails otherwise).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 32-byte hex key for AES-256 encryption of sender credentials/tokens
APP_ENCRYPTION_KEY=

# --- email sending ---
# Provider is chosen per sender account (ses/gmail/smtp). Set EMAIL_DRIVER=mock
# to force the mock backend for every sender (local dev without real SMTP or
# AWS/Google creds) — sends are logged, never delivered. Blank = real delivery.
EMAIL_DRIVER=

# --- system email (password resets, notification emails, weekly summary) ---
# The platform's own mail, separate from campaign senders. Any SMTP mailbox
# works (e.g. a Gmail account with an app password: smtp.gmail.com, port 465);
# later, SES's SMTP endpoint with no code change. Unset (or EMAIL_DRIVER=mock)
# = nothing is sent; outside production the email is printed in the API log,
# so a reset link can be copied from there.
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_SECURE=
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASS=
SYSTEM_EMAIL_FROM=

# SSRF guard for workspace SMTP senders: by default only public mail servers on
# ports 25/465/587/2525. "on" also allows private/loopback hosts (a self-hosted
# mail server on your network, or a local test inbox like Mailpit in dev).
SMTP_ALLOW_PRIVATE_HOSTS=

# --- AI (E6) ---
# Claude is reached via AWS Bedrock, not the Anthropic console. AI_DRIVER=mock
# POST /inbox/simulate-reply (dev/demo reply injector) is off in production unless "on".
INBOX_SIMULATE=
# (or blank) uses a deterministic in-process provider — no creds, no network —
# for local dev + tests. Set AI_DRIVER=bedrock to use real Claude, which needs
# AWS_REGION + AWS credentials below and Bedrock model access enabled per region.
AI_DRIVER=mock
# Bedrock model IDs (anthropic.* prefix); overrides for the fast/balanced/powerful tiers.
AI_MODEL_FAST=anthropic.claude-haiku-4-5
AI_MODEL_BALANCED=anthropic.claude-sonnet-5
AI_MODEL_POWERFUL=anthropic.claude-opus-5
# Legacy direct-API key (unused while on Bedrock; kept for reference).
ANTHROPIC_API_KEY=

# --- AWS (SES sending, SNS webhooks, S3 uploads) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_DOMAIN=
S3_BUCKET=

# --- Google (Gmail OAuth sender + Sheets sync) ---
# Both set = "Connect Gmail" (T3.3; scopes openid, email, gmail.send) and
# "Connect Google Sheets" (T2.8; openid, email, spreadsheets.readonly) appear.
# Both flows share this one redirect URL. The redirect URL must be listed exactly under
# the OAuth client's "Authorized redirect URIs" in Google Cloud; in production
# it's https://<api-host>/auth/google/callback (defaults to API_URL + that path).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:4000/auth/google/callback

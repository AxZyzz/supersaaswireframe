# Copy to .env and fill in. NEVER commit real values.

# --- app ---
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
# Production behind a load balancer: number of proxy hops to trust for client IP
# (rate limiting). Leave blank locally.
TRUST_PROXY=
# Beta: "waitlist" makes sign-up invite-only (operator approves waitlist entries
# in /operator and sends the link). Blank/"open" = anyone can sign up.
SIGNUP_MODE=
# Email confirmation at sign-up: new accounts must click an emailed link before
# they can sign in. "on" / "off"; blank = on in production, off elsewhere
# (local dev and tests). Needs the system mailer (SYSTEM_SMTP_*) in production.
EMAIL_VERIFICATION=
# Session cookie (httpOnly refresh token). Host web + API on one site
# (app.example.com + api.example.com) and keep "lax". Only if they live on
# unrelated domains use "none" (forces Secure). COOKIE_DOMAIN is usually blank.
COOKIE_SAMESITE=
COOKIE_DOMAIN=
# Scheduled jobs (notification emails every minute, Monday weekly summary,
# Sheets sync). One shared schedule in Redis across instances. "off" = this
# instance doesn't register or run them (it never removes others' schedules).
JOBS_SCHEDULER=
# Swagger UI at /docs is dev-only; set to "on" to expose it in production.
SWAGGER=

# --- database / queue (matches docker-compose.yml) ---
# App connects as restricted role (RLS enforced); superuser URL is ONLY for migrations.
DATABASE_URL=postgresql://supersaas_app:supersaas_app@127.0.0.1:5432/supersaas
MIGRATE_DATABASE_URL=postgresql://supersaas:supersaas@127.0.0.1:5432/supersaas
REDIS_URL=redis://127.0.0.1:6379
# Idle job workers wait this many seconds between "any work?" checks (BullMQ
# drainDelay; default 300). New jobs still start instantly and scheduled ones
# on time; lower only costs Redis commands (Upstash bills per command).
REDIS_IDLE_POLL_SECONDS=

# --- auth ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
# Production: random >=32 chars each, different from each other (boot fails otherwise).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 32-byte hex key for AES-256 encryption of sender credentials/tokens
APP_ENCRYPTION_KEY=

# --- email sending ---
# Provider is chosen per sender account (ses/gmail/smtp). Set EMAIL_DRIVER=mock
# to force the mock backend for every sender (local dev without real SMTP or
# AWS/Google creds) — sends are logged, never delivered. Blank = real delivery.
EMAIL_DRIVER=

# --- system email (password resets, notification emails, weekly summary) ---
# The platform's own mail, separate from campaign senders. Any SMTP mailbox
# works (e.g. a Gmail account with an app password: smtp.gmail.com, port 465);
# later, SES's SMTP endpoint with no code change. Unset (or EMAIL_DRIVER=mock)
# = nothing is sent; outside production the email is printed in the API log,
# so a reset link can be copied from there.
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_SECURE=
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASS=
SYSTEM_EMAIL_FROM=

# SSRF guard for workspace SMTP senders: by default only public mail servers on
# ports 25/465/587/2525. "on" also allows private/loopback hosts (a self-hosted
# mail server on your network, or a local test inbox like Mailpit in dev).
SMTP_ALLOW_PRIVATE_HOSTS=

# --- AI (E6) ---
# Claude is reached via AWS Bedrock, not the Anthropic console. AI_DRIVER=mock
# POST /inbox/simulate-reply (dev/demo reply injector) is off in production unless "on".
INBOX_SIMULATE=
# (or blank) uses a deterministic in-process provider — no creds, no network —
# for local dev + tests. Set AI_DRIVER=bedrock to use real Claude, which needs
# AWS_REGION + AWS credentials below and Bedrock model access enabled per region.
AI_DRIVER=mock
# Bedrock model IDs (anthropic.* prefix); overrides for the fast/balanced/powerful tiers.
AI_MODEL_FAST=anthropic.claude-haiku-4-5
AI_MODEL_BALANCED=anthropic.claude-sonnet-5
AI_MODEL_POWERFUL=anthropic.claude-opus-5
# Legacy direct-API key (unused while on Bedrock; kept for reference).
ANTHROPIC_API_KEY=
# Gemini (google-stack branch, testing with real AI while Bedrock is pending).
# Set AI_DRIVER=gemini plus EITHER a Gemini API key from Google AI Studio
# (aistudio.google.com) OR Vertex AI (GEMINI_USE_VERTEX=true + a Google Cloud
# project, authenticated with `gcloud auth application-default login`).
# See docs/GOOGLE-STACK.md.
GEMINI_API_KEY=
GEMINI_USE_VERTEX=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
# Gemini model per tier (default: gemini-3.5-flash-lite for all three). Pro models need billing on: then GEMINI_MODEL_POWERFUL=gemini-pro-latest.
# If a model is overloaded or times out, one retry goes to GEMINI_FALLBACK_MODEL
# (default gemini-3.5-flash-lite; "off" disables). GEMINI_TIMEOUT_MS caps each
# Gemini call (default 45000).
GEMINI_FALLBACK_MODEL=
GEMINI_TIMEOUT_MS=

# --- Model router + Model Armor (T08) ---------------------------------------
# Per-workspace daily AI token cap (default 2000000; 0 = no cap). Over it, the
# router drops to a cheaper model; over 2x it refuses non-essential AI tasks.
AI_DAILY_TOKEN_CAP_PER_ORG=
# Model Armor safety screening: off (default) | modelarmor. Template setup:
# infra/model-armor/README.md. Needs GOOGLE_CLOUD_PROJECT and gcloud ADC.
SAFETY_DRIVER=
MODEL_ARMOR_TEMPLATE=
MODEL_ARMOR_LOCATION=
# open (default): if Model Armor is down, log and continue. closed: refuse.
SAFETY_FAIL_MODE=
GEMINI_MODEL_FAST=
GEMINI_MODEL_BALANCED=
GEMINI_MODEL_POWERFUL=

# --- AWS (SES sending, SNS webhooks, S3 uploads) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_DOMAIN=
S3_BUCKET=

# --- Google (Gmail OAuth sender + Sheets sync) ---
# Both set = "Connect Gmail" (T3.3; scopes openid, email, gmail.send) and
# "Connect Google Sheets" (T2.8; openid, email, spreadsheets.readonly) appear.
# Both flows share this one redirect URL. The redirect URL must be listed exactly under
# the OAuth client's "Authorized redirect URIs" in Google Cloud; in production
# it's https://<api-host>/auth/google/callback (defaults to API_URL + that path).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:4000/auth/google/callback

# --- ADK agents over A2A (T09). See apps/agents/README.md --------------------
# Who explains a Review: template (default, no AI) | agent (Python ADK Review analyst) | gemini (direct call).
REVIEW_EXPLAINER=
# Who drafts challenger subjects: gemini (default) | agent (ADK Copywriter) | mock (fixed templates, no AI).
COPYWRITER_DRIVER=
# Where the agents listen (local: uvicorn on 8101 / 8102; cloud: the Agent Engine A2A URL).
REVIEW_ANALYST_URL=
COPYWRITER_URL=
# none = skip the Google access token (local agents). A2A_CARD_PATH = non-default Agent Card path.
A2A_AUTH=
A2A_CARD_PATH=

# --- Scheduled jobs + tracing (T13) -----------------------------------------
# internal (default) = the API runs the loop jobs from its own timers.
# scheduler = Cloud Scheduler owns them (set in production); then these two are required:
CRON_MODE=
# The API's public https URL (the token audience); comma-separate if there are two.
CRON_AUDIENCE=
# The service account Cloud Scheduler runs as, e.g. expelly-scheduler@PROJECT.iam.gserviceaccount.com
CRON_SA_EMAIL=
# Local development only (NODE_ENV=development): send this as X-Cron-Secret to call /internal/cron/*.
CRON_DEV_SECRET=
# on = send traces to Cloud Trace (needs roles/cloudtrace.agent). Default off.
TRACING=
# Share of ordinary requests traced (default 0.1). /internal/*, review and discover are always traced.
TRACING_SAMPLE_RATE=

# --- Discover agent (T10) ----------------------------------------------------
# native (default) = the API's own AI pipeline. agent = the ADK Discover agent over A2A (falls back to native if it cannot answer).
DISCOVER_DRIVER=
DISCOVER_AGENT_URL=
# A whole search is slow: how long to wait for the agent, in ms (default 300000).
DISCOVER_AGENT_TIMEOUT_MS=
# Who may call the API's page-reading tool: the agent's service account, with an ID token for this audience.
AGENT_TOOLS_AUDIENCE=
AGENT_TOOLS_SA_EMAIL=
# Local development only (NODE_ENV=development): a shared secret the local agent sends as X-Agent-Secret.
AGENT_TOOLS_DEV_SECRET=

# Copy to .env and fill in. NEVER commit real values.

# --- app ---
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- database / queue (matches docker-compose.yml) ---
DATABASE_URL=postgresql://supersaas:supersaas@localhost:5432/supersaas
REDIS_URL=redis://localhost:6379

# --- auth ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
# 32-byte hex key for AES-256 encryption of sender credentials/tokens
APP_ENCRYPTION_KEY=

# --- AI ---
ANTHROPIC_API_KEY=

# --- AWS (SES sending, SNS webhooks, S3 uploads) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_DOMAIN=
S3_BUCKET=

# --- Google (Gmail OAuth sender + Sheets sync) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:4000/auth/google/callback

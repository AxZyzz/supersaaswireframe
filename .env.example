# Copy to .env and fill in. NEVER commit real values.

# --- app ---
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
# Production behind a load balancer: number of proxy hops to trust for client IP
# (rate limiting). Leave blank locally.
TRUST_PROXY=
# Beta: "waitlist" makes sign-up invite-only (operator approves waitlist entries
# in /operator and sends the link). Blank/"open" = anyone can sign up.
SIGNUP_MODE=
# Swagger UI at /docs is dev-only; set to "on" to expose it in production.
SWAGGER=

# --- database / queue (matches docker-compose.yml) ---
# App connects as restricted role (RLS enforced); superuser URL is ONLY for migrations.
DATABASE_URL=postgresql://supersaas_app:supersaas_app@localhost:5432/supersaas
MIGRATE_DATABASE_URL=postgresql://supersaas:supersaas@localhost:5432/supersaas
REDIS_URL=redis://localhost:6379

# --- auth ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
# Production: random >=32 chars each, different from each other (boot fails otherwise).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 32-byte hex key for AES-256 encryption of sender credentials/tokens
APP_ENCRYPTION_KEY=

# --- email sending ---
# Provider is chosen per sender account (ses/gmail/smtp). Set EMAIL_DRIVER=mock
# to force the mock backend for every sender (local dev without real SMTP or
# AWS/Google creds) — sends are logged, never delivered. Blank = real delivery.
EMAIL_DRIVER=

# --- AI (E6) ---
# Claude is reached via AWS Bedrock, not the Anthropic console. AI_DRIVER=mock
# POST /inbox/simulate-reply (dev/demo reply injector) is off in production unless "on".
INBOX_SIMULATE=
# (or blank) uses a deterministic in-process provider — no creds, no network —
# for local dev + tests. Set AI_DRIVER=bedrock to use real Claude, which needs
# AWS_REGION + AWS credentials below and Bedrock model access enabled per region.
AI_DRIVER=mock
# Bedrock model IDs (anthropic.* prefix); overrides for the fast/balanced/powerful tiers.
AI_MODEL_FAST=anthropic.claude-haiku-4-5
AI_MODEL_BALANCED=anthropic.claude-sonnet-5
AI_MODEL_POWERFUL=anthropic.claude-opus-5
# Legacy direct-API key (unused while on Bedrock; kept for reference).
ANTHROPIC_API_KEY=

# --- AWS (SES sending, SNS webhooks, S3 uploads) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_DOMAIN=
S3_BUCKET=

# --- Google (Gmail OAuth sender + Sheets sync) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:4000/auth/google/callback
